# Copy to .env and fill in. .env is gitignored.
TYPESAFE_API_KEY=
SOP_DATA_ROOT=./sop-sample-training-data/server_fan
# Host path mounted into the container at /data (docker-compose.yml)
SOP_DATASET_DIR=./sop-sample-training-data
# Comma-separated RTSP camera URLs to offer as sources
SOPVISION_RTSP_URLS=
# Only for a Vercel AI Gateway key: uncomment both lines below. A direct TypeSafe key needs neither
# (the SDK defaults to https://api.typesafe.ai and jev-latest).
# TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
# TYPESAFE_DEFAULT_MODEL=typesafe-ai/jev

# Who makes SOP decisions: jev (default) | decider (local Decider-4B) | laya (local Laya service, e.g. a fine-tune)
# | compare (Jev decides, COMPARE_SHADOW gets the same requests, both answers logged)
DECISION_MODE=jev
# COMPARE_SHADOW=decider
# Fine-tuned Laya checkpoint for the laya service (docker/laya_serve.py), e.g. /data/models/laya-sop-v1-e12
# LAYA_CHECKPOINT=
# Native runs; docker-compose sets http://decider:8001 for the container
# DECIDER_URL=http://localhost:8001
# Pin a different Decider-4B revision (default: v2.1, eb5fbdfc…)
# DECIDER_REVISION=eb5fbdfc9448473ec25e399882912863afbdb70e
# Folder of corporate root CA *.crt files for the Decider image build behind a TLS-intercepting proxy
# CORP_CA_DIR=/usr/local/share/ca-certificates
