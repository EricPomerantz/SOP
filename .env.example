# Copy to .env and fill in. .env is gitignored.
TYPESAFE_API_KEY=
SOP_DATA_ROOT=./sop-sample-training-data/server_fan
# Host path mounted into the container at /data (docker-compose.yml)
SOP_DATASET_DIR=./sop-sample-training-data
# Comma-separated RTSP camera URLs to offer as sources
SOPVISION_RTSP_URLS=
# Jev via Vercel AI Gateway: use your AI Gateway key above, plus these two lines.
# Direct TypeSafe keys: remove both (SDK defaults: https://api.typesafe.ai, jev-latest).
TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
TYPESAFE_DEFAULT_MODEL=typesafe-ai/jev
